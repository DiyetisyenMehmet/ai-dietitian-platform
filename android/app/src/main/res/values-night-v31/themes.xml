<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Diewish" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:isLightTheme">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@drawable/diewish_launch_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/diewish_primary</item>
        <item name="android:navigationBarColor">#0F1412</item>
        <item name="android:statusBarColor">#0F1412</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Same rounded approved artwork as the first WebView loading cover. -->
        <item name="android:windowSplashScreenBackground">#0F1412</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/diewish_splash_icon</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
</resources>
