# Platform metadata (managed by Abacus.AI)
.abacus.donotdelete

# Auto-generated document previews of Markdown files
*.pdf
*.docx
# Keep the frozen project spec PDF under docs/
!docs/*.pdf

# OS / editor
.DS_Store
.idea/
.vscode/

# Logs
*.log

# Cross-platform QA: evidence and private session material never enter Git.
.qa-artifacts/
.qa-private/
ios/build/
ios/**/*.xcuserstate
ios/**/xcuserdata/

qa/platform/__pycache__/
android/.gradle/
android/build/
android/app/build/
