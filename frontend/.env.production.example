# ─────────────────────────────────────────────────────────────
# Diewish — Frontend PRODUCTION environment (example)
# NEXT_PUBLIC_* values are public and inlined at BUILD time.
# Never put API keys or secrets in NEXT_PUBLIC_* variables.
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_API_BASE_URL=https://api.diewish.com/api
NEXT_PUBLIC_SITE_URL=https://diewish.com

# Public merchant identity. These must be the REAL values matching the iyzico
# application, tax/registry documents and the website's Contact page.
# Allowed entity types: TACIR or ESNAF.
NEXT_PUBLIC_BUSINESS_ENTITY_TYPE=TACIR
NEXT_PUBLIC_LEGAL_NAME="REPLACE_WITH_REAL_LEGAL_NAME"
NEXT_PUBLIC_BRAND_NAME="Diewish"
# TACIR: MERSIS is required by our iyzico-readiness check.
NEXT_PUBLIC_MERSIS_NUMBER="REPLACE_WITH_REAL_MERSIS"
# ESNAF: configure the real tax number instead; TACIR may also publish it if appropriate.
NEXT_PUBLIC_TAX_NUMBER=""
NEXT_PUBLIC_REGISTERED_ADDRESS="REPLACE_WITH_REAL_REGISTERED_ADDRESS"
NEXT_PUBLIC_KEP_ADDRESS="REPLACE_WITH_REAL_KEP"
NEXT_PUBLIC_BUSINESS_EMAIL="REPLACE_WITH_REAL_BUSINESS_EMAIL"
NEXT_PUBLIC_BUSINESS_PHONE="REPLACE_WITH_REAL_PHONE"
NEXT_PUBLIC_CHAMBER_NAME="REPLACE_WITH_REAL_CHAMBER"
NEXT_PUBLIC_CHAMBER_RULES_URL="https://REPLACE_WITH_OFFICIAL_CHAMBER_OR_RULES_URL"
