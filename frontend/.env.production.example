# ─────────────────────────────────────────────────────────────
# Diewish — Frontend PRODUCTION environment (example)
# Copy to `.env` (or pass as Docker build args) BEFORE building.
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined into the client bundle at BUILD
# time, not read at runtime. Changing them requires a frontend rebuild.
# ─────────────────────────────────────────────────────────────

# Public base URL of the backend API (include the /api prefix).
# Must match the backend's API_PREFIX and be reachable from the browser.
NEXT_PUBLIC_API_BASE_URL=https://api.diewish.com/api

# Public URL of this web frontend (used for absolute links / metadata).
NEXT_PUBLIC_SITE_URL=https://diewish.com
