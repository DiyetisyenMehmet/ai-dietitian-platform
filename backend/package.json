{
  "name": "diewish-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for Diewish — personal health & nutrition platform (Modular Monolith, DDD-ready).",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/lib/storage.test.ts src/modules/ai-chat/nutrition-grounding.test.ts src/modules/blood-test/blood-test.upload.test.ts src/modules/blood-test-analysis/enhancement/document-enhancement.service.test.ts src/modules/blood-test-analysis/normalization/normalization.service.test.ts src/modules/blood-test-analysis/extraction/pdf-text-extractor.test.ts src/modules/blood-test-analysis/validation/document-validation-routing.test.ts src/modules/food-scan/food-scan.service.test.ts src/modules/food-scan/food-vision.provider.test.ts src/modules/nutrition-data/barcode.test.ts src/modules/nutrition-data/nutrition-attention.test.ts src/modules/nutrition-data/nutrition-calculator.test.ts src/modules/nutrition-data/normalization.test.ts src/modules/nutrition-data/nutrition-data.service.test.ts src/modules/nutrition-data/nutrition-match.test.ts src/modules/nutrition-data/nutrition-query-aliases.test.ts src/modules/nutrition-data/nutrition-scan-result.test.ts src/modules/nutrition-data/personalization.test.ts src/modules/nutrition-plan/calculations/meal-timing.test.ts src/modules/nutrition-plan/work-schedule-policy.test.ts src/modules/nutrition-plan/nutrition-plan-safety.test.ts src/modules/nutrition-plan/meal-generator/nutrition-target-validator.test.ts src/modules/nutrition-plan/nutrition-plan-realism.test.ts src/modules/tracking/weight-check-in.test.ts",
    "test:integration": "node --import tsx --test src/integration/auth-security.integration.test.ts src/integration/auth-onboarding.integration.test.ts src/integration/ai-chat.integration.test.ts src/integration/nutrition-data.integration.test.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "start:migrate": "prisma migrate deploy && node dist/index.js"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "bcryptjs": "^2.4.3",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.22.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.3.0",
    "pdf-parse": "^1.1.1",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "sharp": "^0.35.4",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "tesseract.js": "^5.1.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "1.7.5",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "22.10.7",
    "@types/pdf-parse": "^1.1.4",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "4.1.7",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.0.1",
    "pino-pretty": "13.0.0",
    "prettier": "3.4.2",
    "prisma": "6.2.1",
    "tsx": "4.23.13",
    "typescript": "5.7.3",
    "typescript-eslint": "8.21.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}