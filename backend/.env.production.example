# Diewish backend production environment example
# NEVER commit real secrets. Use Google Secret Manager / Cloud Run secret refs.

NODE_ENV=production
# Local/container fallback only. Do NOT manually set PORT in Cloud Run; Cloud Run injects it.
PORT=4000

API_PREFIX=/api
CORS_ORIGIN=https://diewish.com
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

DATABASE_URL="postgresql://USER:PASSWORD@db-host:5432/diewish?schema=public&sslmode=require"

JWT_ACCESS_SECRET="REPLACE_WITH_STRONG_UNIQUE_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_STRONG_UNIQUE_SECRET"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REFRESH_TOKEN_TTL_DAYS=7
JWT_ISSUER=diewish
BCRYPT_ROUNDS=12

APP_WEB_URL=https://diewish.com
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
ACCOUNT_DELETION_GRACE_DAYS=30

# Durable private health-document storage for Cloud Run.
# Assign the Cloud Run backend a user-managed service identity with only the
# required bucket object permissions (for example roles/storage.objectUser on
# this bucket). Authentication comes from Cloud Run metadata/ADC; NEVER set
# GOOGLE_APPLICATION_CREDENTIALS or embed a storage service-account private key.
STORAGE_PROVIDER=gcs
STORAGE_GCS_BUCKET=REPLACE_WITH_PRIVATE_DIEWISH_HEALTH_BUCKET
STORAGE_GCS_PREFIX=diewish
# Local fallback is development-only; Cloud Run filesystems are ephemeral.
STORAGE_LOCAL_ROOT=./storage/uploads
BLOOD_TEST_MAX_FILE_SIZE_MB=15
BLOOD_TEST_TEXT_MIN_CHARS=100
BLOOD_TEST_VALIDATION_MIN_CONFIDENCE=95
BLOOD_TEST_VALIDATION_MIN_PARAMETERS=3

# Preferred current AI integration: Abacus RouteLLM official OpenAI-compatible endpoint.
AI_PROVIDER=abacus
ABACUS_API_KEY=REPLACE_WITH_ROUTELLM_API_KEY
ABACUS_API_BASE_URL=https://routellm.abacus.ai/v1
ABACUS_MODEL=route-llm
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2
AI_REQUEST_TIMEOUT_MS=60000

# Optional non-Abacus OpenAI-compatible provider instead:
# AI_PROVIDER=openai
# AI_API_KEY=REPLACE_WITH_PROVIDER_KEY
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o

# iyzico remains available for a future web-purchase channel. Current launch
# direction can leave it unconfigured while Android purchases use Google Play.
PAYMENT_PROVIDER=iyzico
IYZICO_ENV=production
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_API_KEY=REPLACE_ONLY_IF_WEB_IYZICO_IS_ENABLED
IYZICO_SECRET_KEY=REPLACE_ONLY_IF_WEB_IYZICO_IS_ENABLED
IYZICO_WEBHOOK_SECRET=REPLACE_ONLY_IF_WEB_IYZICO_IS_ENABLED
IYZICO_CALLBACK_URL=https://api.diewish.com/api/payments/callback
BILLING_CURRENCY=TRY

# Google Play Billing. These are backend-only values. The private key must be
# injected from Secret Manager, never committed or shipped in the Android app.
GOOGLE_PLAY_PACKAGE_NAME=REPLACE_AFTER_PLAY_APP_IS_CREATED
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=REPLACE_WITH_PLAY_SERVICE_ACCOUNT_EMAIL
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=REPLACE_FROM_SECRET_MANAGER
GOOGLE_PLAY_PREMIUM_PRODUCT_ID=diewish_premium
GOOGLE_PLAY_PREMIUM_PLUS_PRODUCT_ID=diewish_premium_plus

# Public data-controller identity used in backend-served KVKK/legal texts.
# Values must exactly match the real identity published on the Diewish website.
LEGAL_CONTROLLER_NAME="REPLACE_WITH_REAL_LEGAL_NAME"
LEGAL_CONTROLLER_ADDRESS="REPLACE_WITH_REAL_REGISTERED_ADDRESS"
LEGAL_CONTROLLER_EMAIL="REPLACE_WITH_REAL_BUSINESS_EMAIL"
LEGAL_CONTROLLER_KEP="REPLACE_WITH_REAL_KEP_IF_APPLICABLE"
LEGAL_CONTROLLER_PHONE="REPLACE_WITH_REAL_PHONE"

LEGAL_PRIVACY_POLICY_VERSION=2026-09-03
LEGAL_TERMS_OF_SERVICE_VERSION=2026-09-03
LEGAL_MEDICAL_DISCLAIMER_VERSION=2026-09-03
LEGAL_KVKK_CONSENT_VERSION=2026-09-03
