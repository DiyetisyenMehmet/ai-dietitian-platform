// Prisma schema — AI Dietitian Platform (backend foundation).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  @@map("health_checks")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                  String           @id @default(uuid())
  email               String           @unique
  passwordHash        String
  fullName            String?
  role                UserRole         @default(USER)
  isActive            Boolean          @default(true)
  emailVerifiedAt     DateTime?
  onboardingCompleted Boolean          @default(false)
  subscriptionTier    SubscriptionTier @default(FREE)
  lastLoginAt         DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  refreshTokens     RefreshToken[]
  profile           UserProfile?
  accountTokens     AccountToken[]
  bloodTestUploads  BloodTestUpload[]
  bloodTestAnalyses BloodTestAnalysis[]
  nutritionPlans    NutritionPlan[]
  nutritionPlanDeviations NutritionPlanDeviation[]
  chatConversations ChatConversation[]
  aiUsageEvents     AiUsageEvent[]
  subscriptions     Subscription[]
  payments          Payment[]
  consents          ConsentRecord[]

  weightLogs              WeightLog[]
  mealLogs                MealLog[]
  waterLogs               WaterLog[]
  aiMemories              AiMemory[]
  aiConversationSummaries AiConversationSummary[]
  proactiveMessages       ProactiveMessage[]
  weeklyReviews           WeeklyReview[]
  monthlyReviews          MonthlyReview[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  activities              Activity[]
  historyInsights          HistoryInsight[]

  adminRoleMemberships      AdminUserRole[]
  adminInvitationsReceived AdminInvitation[] @relation("AdminInvitationUser")
  adminInvitationsSent     AdminInvitation[] @relation("AdminInvitationInviter")

  @@map("users")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum DietaryPreference {
  OMNIVORE
  VEGETARIAN
  VEGAN
  PESCATARIAN
  KETO
  PALEO
  MEDITERRANEAN
  GLUTEN_FREE
  OTHER
}

enum WorkScheduleType {
  REGULAR
  VARIABLE_SHIFT
  NIGHT_SHIFT
}

model UserProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth       DateTime          @db.Date
  gender            Gender
  heightCm          Float
  currentWeightKg   Float
  targetWeightKg    Float
  activityLevel     ActivityLevel
  healthConditions  String[]
  allergies         String[]
  dietaryPreference DietaryPreference
  dailyWaterGoalMl  Int
  usualWakeTime     String?
  usualSleepTime    String?
  workScheduleType  WorkScheduleType?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("user_profiles")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum AccountTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AccountToken {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AccountTokenType
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, type])
  @@map("account_tokens")
}

enum AuditAction {
  EMAIL_VERIFICATION_REQUESTED
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  ACCOUNT_DELETION_REQUESTED
  ACCOUNT_DELETION_CANCELED
  ACCOUNT_DELETED
  BLOOD_TEST_UPLOADED
  BLOOD_TEST_REPLACED
  BLOOD_TEST_DELETED
  SUBSCRIPTION_CHECKOUT_STARTED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_EXPIRED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_WEBHOOK_RECEIVED
  CONSENT_GRANTED
  CONSENT_WITHDRAWN
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  action    AuditAction
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

enum BloodTestStatus {
  UPLOADED
  ANALYZING
  ANALYZED
  FAILED
}

model BloodTestUpload {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           BloodTestStatus @default(UPLOADED)
  storageProvider  String
  storageKey       String
  originalFilename String
  mimeType         String
  fileSizeBytes    Int
  checksumSha256   String
  label            String?
  testDate         DateTime?       @db.Date
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  analysis BloodTestAnalysis?

  @@index([userId])
  @@index([userId, status])
  @@map("blood_test_uploads")
}

enum BloodTestAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model BloodTestAnalysis {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bloodTestId String          @unique
  bloodTest   BloodTestUpload @relation(fields: [bloodTestId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status           BloodTestAnalysisStatus @default(PENDING)
  extractionMethod String?
  rawExtractedText String? @db.Text
  normalizedValues Json
  abnormalValues   Json
  abnormalCount    Int     @default(0)
  aiExplanations         Json
  nutritionImplications  Json
  overallRecommendations Json
  summary                String? @db.Text
  aiProvider             String?
  aiModel                String?
  processingTimeMs       Int?
  errorMessage           String?

  @@index([userId])
  @@index([bloodTestId])
  @@map("blood_test_analyses")
}

enum ReferenceRangeGender {
  MALE
  FEMALE
  ALL
}

model BloodTestReferenceRange {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  biomarkerCode   String
  biomarkerName   String
  biomarkerNameTr String?
  unit            String
  minValue        Float?
  maxValue        Float?
  optimalMin      Float?
  optimalMax      Float?
  gender          ReferenceRangeGender @default(ALL)
  ageMin          Int?
  ageMax          Int?
  country         String?
  laboratoryId    String?
  isActive        Boolean              @default(true)
  source          String               @default("STANDARD")
  notes           String?

  @@index([biomarkerCode])
  @@index([isActive])
  @@map("blood_test_reference_ranges")
}

/// Current user-selectable horizons are 7, 14 and 30 days.
/// SIXTY_DAY remains legacy-only so historical rows can still be read safely.
enum NutritionPlanDuration {
  SEVEN_DAY
  FOURTEEN_DAY
  THIRTY_DAY
  SIXTY_DAY
}

enum NutritionPlanStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NutritionPlanDeviationScope {
  FOOD
  MEAL
  DAY
}

enum NutritionPlanDeviationType {
  SKIPPED
  REPLACED
  EXTRA
  PORTION_CHANGED
}

model NutritionPlan {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  startDate DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  deletedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodTestAnalysisId String?
  duration NutritionPlanDuration
  version  Int                   @default(1)
  isActive Boolean               @default(true)
  status   NutritionPlanStatus   @default(COMPLETED)
  bmr           Float
  tdee          Float
  dailyCalories Float
  proteinGrams  Float
  carbsGrams    Float
  fatGrams      Float
  waterMl       Float
  mealsPerDay   Int
  mealTiming      Json
  dailyPlans      Json
  explanations    Json
  recommendations Json
  summary String? @db.Text
  aiProvider       String?
  aiModel          String?
  processingTimeMs Int?
  errorMessage     String?
  deviations       NutritionPlanDeviation[]

  @@index([userId])
  @@index([userId, duration, isActive])
  @@index([userId, deletedAt])
  @@map("nutrition_plans")
}

model NutritionPlanDeviation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan   NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  dayNumber Int
  mealIndex Int?
  foodIndex Int?
  scope     NutritionPlanDeviationScope
  type      NutritionPlanDeviationType

  plannedItemName String?
  actualItemName  String?
  plannedPortion  String?
  actualPortion   String?
  note            String?

  @@index([userId, createdAt])
  @@index([planId, dayNumber])
  @@map("nutrition_plan_deviations")
}

enum SubscriptionTier {
  FREE
  PREMIUM
  PREMIUM_PLUS
}

enum AiUsageFeature {
  DIETITIAN_CHAT
  BLOOD_TEST_ANALYSIS
  NUTRITION_PLAN
}

model AiUsageEvent {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature         AiUsageFeature
  provider        String
  model           String
  estimatedTokens Int?
  createdAt       DateTime       @default(now())

  @@index([userId, feature, createdAt])
  @@map("ai_usage_events")
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatConversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String?
  pinnedAt DateTime?
  messages ChatMessage[]

  @@index([userId])
  @@index([userId, pinnedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role    ChatRole
  content String   @db.Text
  provider String?
  model    String?

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentProvider {
  IYZICO
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Subscription {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier     SubscriptionTier
  status   SubscriptionStatus @default(PENDING)
  provider PaymentProvider    @default(IYZICO)
  providerRef             String?
  providerSubscriptionRef String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([providerRef])
  @@map("subscriptions")
}

model Payment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  provider PaymentProvider @default(IYZICO)
  status   PaymentStatus   @default(PENDING)
  amountMinor Int
  currency    String @default("TRY")
  providerPaymentId      String?
  providerConversationId String?
  rawStatus              String?
  failureReason          String?

  @@index([userId])
  @@index([subscriptionId])
  @@index([providerConversationId])
  @@map("payments")
}

model PaymentWebhookEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  provider        PaymentProvider @default(IYZICO)
  providerEventId String          @unique
  eventType       String?
  signatureValid  Boolean         @default(false)
  processedAt     DateTime?
  payload         Json

  @@index([provider])
  @@map("payment_webhook_events")
}

enum LegalDocumentType {
  PRIVACY_POLICY
  TERMS_OF_SERVICE
  MEDICAL_DISCLAIMER
  KVKK_EXPLICIT_CONSENT
}

model ConsentRecord {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            LegalDocumentType
  documentVersion String
  granted         Boolean
  grantedAt       DateTime?
  withdrawnAt     DateTime?
  ipAddress String?
  userAgent String?

  @@index([userId, type, createdAt])
  @@map("consent_records")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model WeightLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg  Float
  note      String?
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, loggedAt])
  @@map("weight_logs")
}

model MealLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealType  MealType
  name      String?
  calories  Float?
  proteinG  Float?
  carbsG    Float?
  fatG      Float?
  sodiumMg  Float?
  sugarG    Float?
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, loggedAt])
  @@map("meal_logs")
}

model WaterLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMl  Int
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, loggedAt])
  @@map("water_logs")
}

enum AiMemoryType {
  WEIGHT_TREND
  MEAL_HABITS
  BLOOD_TESTS
  GOALS
  MISTAKES
  ACHIEVEMENTS
  ACTIVITY
  CONVERSATION_SUMMARY
}

model AiMemory {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryType AiMemoryType
  content    Json
  embedding  Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  expiresAt  DateTime?

  @@index([userId, memoryType, updatedAt])
  @@map("ai_memories")
}

model AiConversationSummary {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber  Int
  year        Int
  summary     String   @db.Text
  keyInsights Json
  createdAt   DateTime @default(now())

  @@unique([userId, weekNumber, year])
  @@index([userId, year, weekNumber])
  @@map("ai_conversation_summaries")
}

enum ProactiveMessageType {
  MISSED_MEAL
  MISSED_WEIGHT
  GOAL_BEHIND
  LOW_WATER
  INACTIVITY
  RISK_ALERT
  WEEKLY_REVIEW
  MONTHLY_REVIEW
}

model ProactiveMessage {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         ProactiveMessageType
  message      String               @db.Text
  isRead       Boolean              @default(false)
  scheduledFor DateTime             @default(now())
  createdAt    DateTime             @default(now())

  @@index([userId, isRead, scheduledFor])
  @@map("proactive_messages")
}

enum WeightTrend {
  IMPROVING
  STABLE
  DECLINING
}

model WeeklyReview {
  id                 String      @id @default(uuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber         Int
  year               Int
  score              Int
  weightTrend        WeightTrend
  mealConsistency    Int
  waterConsistency   Int
  proteinConsistency Int
  coachComments      String      @db.Text
  recommendations    Json
  nextWeekPriorities Json
  createdAt          DateTime    @default(now())

  @@unique([userId, weekNumber, year])
  @@index([userId, year, weekNumber])
  @@map("weekly_reviews")
}

model MonthlyReview {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month             Int
  year              Int
  progressSummary   String   @db.Text
  habitsAnalysis    String   @db.Text
  improvements      Json
  riskAreas         Json
  aiEvaluation      String   @db.Text
  motivationMessage String   @db.Text
  priorities        Json
  createdAt         DateTime @default(now())

  @@unique([userId, month, year])
  @@index([userId, year, month])
  @@map("monthly_reviews")
}

enum NotificationType {
  PROACTIVE_MESSAGE
  WEEKLY_REVIEW
  MONTHLY_REVIEW
  RISK_ALERT
  GOAL_REMINDER
  WATER_REMINDER
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  title        String
  body         String           @db.Text
  scheduledFor DateTime
  deliveredAt  DateTime?
  metadata     Json?
  createdAt    DateTime         @default(now())

  @@index([userId, scheduledFor])
  @@index([deliveredAt])
  @@map("notifications")
}

model NotificationPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealReminders         Boolean  @default(false)
  waterReminders        Boolean  @default(false)
  activityReminders     Boolean  @default(false)
  sleepReminders        Boolean  @default(false)
  weeklySummary         Boolean  @default(false)
  coachTips             Boolean  @default(false)
  bloodTestReminders    Boolean  @default(false)
  productUpdates        Boolean  @default(false)
  waterReminderTime     String   @default("10:00")
  activityReminderTime  String   @default("18:00")
  sleepReminderTime     String   @default("22:30")
  weeklySummaryDay      Int      @default(0)
  weeklySummaryTime     String   @default("10:00")
  timezoneOffsetMinutes Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("notification_preferences")
}

enum ActivityType {
  WALKING
  RUNNING
  CYCLING
  SWIMMING
  STRENGTH_TRAINING
  PILATES
  HOME_EXERCISE
  YOGA
  HIIT
  SPORTS
  OTHER
}

model Activity {
  id                 String       @id @default(uuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               ActivityType
  name               String?
  durationMinutes    Int
  distanceKm         Float?
  perceivedIntensity Int?
  caloriesBurned     Float?
  note               String?
  loggedAt           DateTime     @default(now())
  createdAt          DateTime     @default(now())

  @@index([userId, loggedAt])
  @@map("activities")
}


enum HistoryInsightScope {
  DAY
  WEEK
  MONTH
}

enum HistoryInsightSource {
  AI
  RULE_BASED
}

model HistoryInsight {
  id          String               @id @default(uuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       HistoryInsightScope
  periodKey   String
  timezone    String
  contextHash String
  content     Json
  source      HistoryInsightSource
  provider    String?
  model       String?
  generatedAt DateTime
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([userId, scope, periodKey, timezone])
  @@index([userId, scope, updatedAt])
  @@map("history_insights")
}


enum AdminAuditRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model AdminRole {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions AdminRolePermission[]
  members     AdminUserRole[]

  @@map("admin_roles")
}

model AdminPermission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime        @default(now())
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("admin_role_permissions")
}

model AdminUserRole {
  userId            String
  roleId            String
  assignedByAdminId String?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("admin_user_roles")
}

model AdminInvitation {
  id               String   @id @default(uuid())
  userId           String
  invitedByAdminId String
  email            String
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime @default(now())

  user      User @relation("AdminInvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User @relation("AdminInvitationInviter", fields: [invitedByAdminId], references: [id], onDelete: Restrict)

  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@index([invitedByAdminId, createdAt])
  @@index([expiresAt])
  @@map("admin_invitations")
}

model AdminAuditEvent {
  id            String              @id @default(uuid())
  actorAdminId  String
  action        String
  targetType    String
  targetId      String
  beforeState   Json?
  afterState    Json?
  reason        String?
  environment   String
  correlationId String
  requestId     String
  riskLevel     AdminAuditRiskLevel
  createdAt     DateTime            @default(now())

  @@index([actorAdminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([correlationId])
  @@map("admin_audit_events")
}
