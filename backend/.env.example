# ─────────────────────────────────────────────────────────────
# Diewish — Backend environment (example)
# Copy to `.env` and adjust values for your environment.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000

# API
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Rate limiting (global)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Rate limiting (auth endpoints — stricter)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://dietitian:dietitian_dev_pw@127.0.0.1:5432/ai_dietitian?schema=public"

# Authentication
# Generate strong secrets, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-min-32-chars-access-secret-000000"
JWT_REFRESH_SECRET="change-me-min-32-chars-refresh-secret-00000"
JWT_ACCESS_TTL=15m
# Canonical refresh lifetime for both JWT and persisted expiry.
JWT_REFRESH_TTL=7d
JWT_ISSUER=diewish
BCRYPT_ROUNDS=12
# Refresh token is browser-inaccessible and carried only in this HttpOnly cookie.
REFRESH_COOKIE_NAME=diewish_refresh
# lax | strict | none. Use none only for intentionally cross-site frontend/API topologies.
REFRESH_COOKIE_SAME_SITE=lax

# Account lifecycle
APP_WEB_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
ACCOUNT_DELETION_GRACE_DAYS=30

# File storage / blood-test uploads
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage/uploads
BLOOD_TEST_MAX_FILE_SIZE_MB=15
