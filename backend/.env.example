# ─────────────────────────────────────────────────────────────
# Diewish — Backend environment (development example)
# Copy to `.env` and adjust values for your local environment.
# NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

DATABASE_URL="postgresql://dietitian:dietitian_dev_pw@127.0.0.1:5432/ai_dietitian?schema=public"

JWT_ACCESS_SECRET="change-me-min-32-chars-access-secret-000000"
JWT_REFRESH_SECRET="change-me-min-32-chars-refresh-secret-00000"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REFRESH_TOKEN_TTL_DAYS=7
JWT_ISSUER=diewish
BCRYPT_ROUNDS=12

APP_WEB_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
ACCOUNT_DELETION_GRACE_DAYS=30

# Local development uses disk. Production Cloud Run must use durable private GCS.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage/uploads
# Used only when STORAGE_PROVIDER=gcs. Cloud Run authenticates with its service
# identity through the metadata server; do not add a service-account key file.
STORAGE_GCS_BUCKET=
STORAGE_GCS_PREFIX=diewish
BLOOD_TEST_MAX_FILE_SIZE_MB=15
BLOOD_TEST_TEXT_MIN_CHARS=100
BLOOD_TEST_VALIDATION_MIN_CONFIDENCE=95
BLOOD_TEST_VALIDATION_MIN_PARAMETERS=3

# Provider-agnostic AI. Current Abacus integration uses RouteLLM's official
# OpenAI-compatible endpoint.
AI_PROVIDER=abacus
ABACUS_API_KEY=
ABACUS_API_BASE_URL=https://routellm.abacus.ai/v1
ABACUS_MODEL=route-llm
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2
AI_REQUEST_TIMEOUT_MS=60000

# Optional OpenAI-compatible provider instead:
# AI_PROVIDER=openai
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# iyzico is retained for future web checkout but can stay unconfigured locally.
PAYMENT_PROVIDER=iyzico
IYZICO_ENV=sandbox
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_WEBHOOK_SECRET=
IYZICO_CALLBACK_URL=http://localhost:3000/billing/callback
BILLING_CURRENCY=TRY

# Google Play Billing verification. Keep credentials server-side only.
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_PLAY_PREMIUM_PRODUCT_ID=diewish_premium
GOOGLE_PLAY_PREMIUM_PLUS_PRODUCT_ID=diewish_premium_plus

# Public data-controller identity. Development may use placeholders; production
# must use the real controller/merchant identity published to users.
LEGAL_CONTROLLER_NAME=Diewish
LEGAL_CONTROLLER_ADDRESS=
LEGAL_CONTROLLER_EMAIL=diewishdestek@hotmail.com
LEGAL_CONTROLLER_KEP=
LEGAL_CONTROLLER_PHONE=
LEGAL_PRIVACY_POLICY_VERSION=2026-09-03
LEGAL_TERMS_OF_SERVICE_VERSION=2026-09-03
LEGAL_MEDICAL_DISCLAIMER_VERSION=2026-09-03
LEGAL_KVKK_CONSENT_VERSION=2026-09-03
