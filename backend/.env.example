# ─────────────────────────────────────────────────────────────
# Diewish — Backend environment (example)
# Copy to `.env` and adjust values for your environment.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000

LOG_LEVEL=info

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

DATABASE_URL="postgresql://dietitian:dietitian_dev_pw@127.0.0.1:5432/ai_dietitian?schema=public"

JWT_ACCESS_SECRET="change-me-min-32-chars-access-secret-000000"
JWT_REFRESH_SECRET="change-me-min-32-chars-refresh-secret-00000"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=diewish
BCRYPT_ROUNDS=12
REFRESH_COOKIE_NAME=diewish_refresh
REFRESH_COOKIE_SAME_SITE=lax

APP_WEB_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
ACCOUNT_DELETION_GRACE_DAYS=30

STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage/uploads
BLOOD_TEST_MAX_FILE_SIZE_MB=15
BLOOD_TEST_UPLOAD_RATE_LIMIT_WINDOW_MS=900000
BLOOD_TEST_UPLOAD_RATE_LIMIT_MAX=10
